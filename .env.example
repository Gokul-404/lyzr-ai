# GitAgent Interviewer Configuration

# GitHub Personal Access Token (create at https://github.com/settings/tokens)
# Required scopes: repo, read:user
GITHUB_TOKEN=your_github_pat_here

# Google Gemini API Key (FREE TIER - create at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Your GitHub username (for fork source specification)
GITHUB_USERNAME=your_github_username

# Optional: API endpoints (defaults to GitHub and Google Generative AI APIs)
GITHUB_API_URL=https://api.github.com
GEMINI_API_URL=https://generativelanguage.googleapis.com

# Optional: Logging level
LOG_LEVEL=INFO
